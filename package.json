{
  "name": "@falche/yellow-jacket",
  "version": "0.4.1",
  "description": "Developer-first HTTP regression testing for routes and API workflows.",
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "yellow-jacket": "dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "test:package": "node scripts/package-smoke.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run test:package",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "keywords": [
    "http",
    "regression-testing",
    "api-testing",
    "git-hooks",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Loxime/yellow-jacket.git"
  },
  "homepage": "https://loxime.github.io/yellow-jacket/",
  "bugs": {
    "url": "https://github.com/Loxime/yellow-jacket/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^5.8.3",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
